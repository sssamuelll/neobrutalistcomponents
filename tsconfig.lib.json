  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src/lib",
    "types": []
  },
  "include": [
    "src/lib"
  ],
  "exclude": [
    "src/lib/**/*.test.ts",
    "src/lib/**/*.test.tsx",
    "src/lib/entry.ts",
    "src/lib/themes/color.ts"
  ]
}
